# Memory Sync Scheduler Environment Configuration

# ================================
# Celery Configuration
# ================================
# Celery Broker URL (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery Result Backend (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================
# MinIO Object Storage Configuration
# ================================
# MinIO Server Endpoint
MINIO_ENDPOINT=localhost:9000

# MinIO Access Key
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key
MINIO_SECRET_KEY=minioadmin

# MinIO SSL/TLS (true/false)
MINIO_SECURE=false

# MinIO Bucket Name for Memory Storage
MINIO_MEMORY_BUCKET=user-memories

# ================================
# Database Configuration
# ================================
# Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/suagent

# ================================
# Scheduler Configuration
# ================================
# Maximum concurrent users to process
MAX_CONCURRENT_USERS=10

# Batch size for database queries
BATCH_SIZE=100

# Memory sync retry delay in seconds
MEMORY_SYNC_RETRY_DELAY=300

# Maximum retry attempts for memory sync
MEMORY_SYNC_MAX_RETRIES=3

# ================================
# Logging Configuration
# ================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ================================
# Email Alert Configuration
# ================================
# Enable email alerts (true/false)
ALERT_EMAIL_ENABLED=false

# SMTP Server Host
ALERT_EMAIL_SMTP_HOST=localhost

# SMTP Server Port
ALERT_EMAIL_SMTP_PORT=587

# SMTP Username
ALERT_EMAIL_USERNAME=

# SMTP Password
ALERT_EMAIL_PASSWORD=

# Alert Email Recipients (comma separated)
ALERT_EMAIL_TO=admin@example.com,ops@example.com

# ================================
# Performance Configuration
# ================================
# Celery Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50

# Task Timeouts (in seconds)
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# ================================
# Security Configuration
# ================================
# Redis Password (if required)
REDIS_PASSWORD=

# RabbitMQ Password (if different from guest)
RABBITMQ_PASSWORD=

# MinIO SSL Certificate Path (if using SSL)
MINIO_SSL_CERT_PATH=

# MinIO SSL Key Path (if using SSL)
MINIO_SSL_KEY_PATH=