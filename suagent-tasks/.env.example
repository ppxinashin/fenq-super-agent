# ============================================
# Fenq Super Agent - Memory Sync Scheduler
# Environment Configuration Template
# ============================================
# Copy this file to .env and update the values

# ============================================
# 基础配置
# ============================================
# 应用名称
APP_NAME="Fenq Super Agent Scheduler"

# 应用版本
APP_VERSION="0.1.0"

# 调试模式 (true/false)
DEBUG=false

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Celery 核心配置
# ============================================
# Celery Broker URL (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery Result Backend (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 任务序列化配置
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# 任务执行配置
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_CONCURRENCY=4

# 重试配置
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_TASK_ACKS_LATE=true

# ============================================
# PostgreSQL 数据库配置
# ============================================
# 数据库连接参数
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=suagent

# 或者使用完整数据库URL (会覆盖上面的配置)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/suagent

# ============================================
# Redis 配置
# ============================================
# Redis 连接参数
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# RabbitMQ 配置
# ============================================
# RabbitMQ 连接参数 (如果使用自定义连接)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ============================================
# MinIO 对象存储配置
# ============================================
# MinIO 服务器配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_MEMORY_BUCKET=user-memories

# MinIO SSL 配置 (如果使用 HTTPS)
# MINIO_SSL_CERT_PATH=/path/to/cert.pem
# MINIO_SSL_KEY_PATH=/path/to/key.pem

# ============================================
# 调度器配置
# ============================================
# 记忆同步配置
MAX_CONCURRENT_USERS=10
BATCH_SIZE=100
MEMORY_SYNC_RETRY_DELAY=300
MEMORY_SYNC_MAX_RETRIES=3
MEMORY_SYNC_ENABLED=true
MEMORY_CLEANUP_ENABLED=true
MEMORY_CLEANUP_DAYS=30

# 定时任务时间配置
MEMORY_SYNC_SCHEDULE_HOUR=2
MEMORY_SYNC_SCHEDULE_MINUTE=0
MEMORY_SYNC_DATE_RANGE_DAYS=1

# ============================================
# Flower 监控配置
# ============================================
# 启用 Flower 监控界面
FLOWER_ENABLED=true
FLOWER_PORT=5555
# FLOWER_BASIC_AUTH=admin:password

# ============================================
# 告警配置
# ============================================
# 邮件告警配置
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=localhost
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=admin@example.com,ops@example.com

# ============================================
# 日志配置
# ============================================
# 日志格式
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# 日志文件配置 (可选)
# LOG_FILE_PATH=/var/log/suagent-scheduler.log
# LOG_ROTATION="1 day"
# LOG_RETENTION="30 days"