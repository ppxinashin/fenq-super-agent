# ===== 应用基础 =====
APP_NAME=Fenq Super Agent Memory Sync Task
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ===== PostgreSQL（任务数据、JobStore）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=suagent
POSTGRES_PASSWORD=postgres
POSTGRES_DB=super_agent_db
# 可选：单独指定 JobStore（不设置则复用上述连接）
# SCHEDULER_JOB_STORE_URL=postgresql+psycopg://user:pass@host:5432/db

# ===== 调度设置 =====
SCHEDULER_TIMEZONE=UTC
MEMORY_SYNC_INTERVAL_MINUTES=120
SCHEDULER_MISFIRE_GRACE_SECONDS=300

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

MQ_EXCHANGE=memory.sync
MQ_ROUTING_KEY=memory.sync
MQ_QUEUE=memory.sync.queue
MQ_DEAD_LETTER_EXCHANGE=memory.sync.dlx
MQ_DEAD_LETTER_ROUTING_KEY=memory.sync.dlx
MQ_DEAD_LETTER_QUEUE=memory.sync.dlx.queue
MQ_MESSAGE_TTL_MS=14400000    # 4 小时
MQ_PREFETCH_COUNT=10
MQ_PUBLISH_DELAY_MS=50
MQ_CONSUMER_MAX_CONCURRENCY=5

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=suagent
